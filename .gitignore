/coverage/
/coverage.dat
*.gcda
*.gcno
*.profraw
*.profdata

# Logs, caches, and temporary files
*.log
*.tmp
*.swp
*~
/.cache/
/.tmp/

# Local worktree scratch space
/.worktrees/

# Editor and OS files
.DS_Store
.idea/
.vscode/

# Local environment files
.env
.env.*
!.env.example
/tools/offline/third_party/

tests/data/*
