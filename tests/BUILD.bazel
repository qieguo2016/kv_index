load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "test_support",
    hdrs = ["test_support/test_macros.h"],
    includes = ["."],
    visibility = ["//tests:__subpackages__"],
)

cc_test(
    name = "forward_index_unit_test",
    srcs = ["unit/forward_index_test.cc"],
    size = "small",
    deps = [
        ":test_support",
        "//:kv_index_internal",
        "//:kv_index",
    ],
)

cc_test(
    name = "status_unit_test",
    srcs = ["unit/status_test.cc"],
    size = "small",
    deps = [
        ":test_support",
        "//:kv_index",
    ],
)

cc_test(
    name = "kv_index_smoke_test",
    srcs = ["smoke/kv_index_smoke_test.cc"],
    size = "small",
    tags = ["smoke"],
    deps = [
        ":test_support",
        "//:kv_index",
    ],
)

cc_test(
    name = "forward_index_integration_test",
    srcs = ["integration/forward_index_integration_test.cc"],
    size = "small",
    tags = ["integration"],
    deps = [
        ":test_support",
        "//:kv_index",
    ],
)

test_suite(
    name = "unit_tests",
    tests = [
        ":forward_index_unit_test",
        ":status_unit_test",
    ],
)

test_suite(
    name = "smoke_tests",
    tests = [":kv_index_smoke_test"],
)

test_suite(
    name = "integration_tests",
    tests = [":forward_index_integration_test"],
)

test_suite(
    name = "all_tests",
    tests = [
        ":forward_index_unit_test",
        ":status_unit_test",
        ":forward_index_integration_test",
        ":kv_index_smoke_test",
    ],
)
