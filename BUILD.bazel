load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "kv_index_public_headers",
    hdrs = [
        "include/kv_index/forward_index.h",
        "include/kv_index/kv_index.h",
        "include/kv_index/row.h",
        "include/kv_index/schema.h",
        "include/kv_index/status.h",
        "include/kv_index/types.h",
        "include/kv_index/version.h",
    ],
    includes = ["include"],
)

cc_library(
    name = "kv_index_internal",
    srcs = [
        "src/core/artifact_format.cc",
        "src/core/async_load.cc",
        "src/core/frozen_primary_key_index.cc",
        "src/core/forward_index.cc",
        "src/core/hash.cc",
        "src/core/kafka_update_consumer.cc",
        "src/core/mmap_snapshot_backing.cc",
        "src/core/realtime_delta.cc",
        "src/core/row_storage.cc",
        "src/core/schema.cc",
        "src/core/shard_directory.cc",
        "src/core/shard_state.cc",
        "src/core/snapshot.cc",
        "src/core/snapshot_builder.cc",
        "src/core/update_applier.cc",
        "src/core/update_coordinator.cc",
    ],
    hdrs = [
        "src/core/artifact_format.h",
        "src/core/async_load.h",
        "src/core/byte_io.h",
        "src/core/frozen_primary_key_index.h",
        "src/core/hash.h",
        "src/core/kafka_update_consumer.h",
        "src/core/mmap_snapshot_backing.h",
        "src/core/realtime_delta.h",
        "src/core/row_storage.h",
        "src/core/shard_directory.h",
        "src/core/shard_state.h",
        "src/core/snapshot.h",
        "src/core/snapshot_builder.h",
        "src/core/test_peer.h",
        "src/core/update_applier.h",
        "src/core/update_coordinator.h",
    ],
    copts = [
        "-Xclang",
        "-isystem",
        "-Xclang",
        "/opt/homebrew/opt/librdkafka/include",
    ],
    deps = [":kv_index_public_headers"],
    linkopts = ["/opt/homebrew/opt/librdkafka/lib/librdkafka.dylib"],
    visibility = [
        "//:__pkg__",
        "//tests:__pkg__",
    ],
)

cc_library(
    name = "kv_index_version",
    srcs = ["src/version.cc"],
    deps = [":kv_index_public_headers"],
    visibility = [
        "//:__pkg__",
        "//tests:__pkg__",
    ],
)

cc_library(
    name = "kv_index",
    deps = [":kv_index_public_headers"],
    implementation_deps = [
        ":kv_index_internal",
        ":kv_index_version",
    ],
)
