load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

INTERNAL_VISIBILITY = [
    "//:__pkg__",
    "//tests:__pkg__",
]

cc_library(
    name = "kv_index_public_headers",
    hdrs = [
        "include/kv_index/forward_index.h",
        "include/kv_index/kv_index.h",
        "include/kv_index/row.h",
        "include/kv_index/schema.h",
        "include/kv_index/status.h",
        "include/kv_index/types.h",
        "include/kv_index/version.h",
    ],
    includes = ["include"],
)

cc_library(
    name = "kv_index_base",
    srcs = [
        "src/base/hash.cc",
    ],
    hdrs = [
        "src/base/byte_io.h",
        "src/base/hash.h",
    ],
    deps = [":kv_index_public_headers"],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_model",
    srcs = [
        "src/model/row_storage.cc",
        "src/model/schema.cc",
    ],
    hdrs = [
        "src/model/row_storage.h",
    ],
    deps = [
        ":kv_index_base",
        ":kv_index_public_headers",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_store",
    srcs = [
        "src/store/frozen_primary_key_index.cc",
        "src/store/realtime_delta.cc",
        "src/store/snapshot.cc",
        "src/store/snapshot_builder.cc",
    ],
    hdrs = [
        "src/store/frozen_primary_key_index.h",
        "src/store/realtime_delta.h",
        "src/store/snapshot.h",
        "src/store/snapshot_builder.h",
    ],
    deps = [
        ":kv_index_base",
        ":kv_index_model",
        ":kv_index_public_headers",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_artifact",
    srcs = [
        "src/artifact/artifact_format.cc",
        "src/artifact/mmap_snapshot_backing.cc",
    ],
    hdrs = [
        "src/artifact/artifact_format.h",
        "src/artifact/mmap_snapshot_backing.h",
    ],
    deps = [
        ":kv_index_base",
        ":kv_index_public_headers",
        ":kv_index_store",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_artifact_builder",
    srcs = [
        "src/artifact/artifact_writer.cc",
    ],
    hdrs = [
        "src/artifact/artifact_writer.h",
    ],
    deps = [
        ":kv_index_artifact",
        ":kv_index_base",
        ":kv_index_model",
        ":kv_index_public_headers",
        ":kv_index_store",
    ],
)

cc_library(
    name = "kv_index_runtime",
    srcs = [
        "src/runtime/shard_directory.cc",
        "src/runtime/shard_state.cc",
    ],
    hdrs = [
        "src/runtime/shard_directory.h",
        "src/runtime/shard_state.h",
    ],
    deps = [
        ":kv_index_artifact",
        ":kv_index_public_headers",
        ":kv_index_store",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_ingest",
    srcs = [
        "src/ingest/kafka_update_consumer.cc",
        "src/ingest/update_applier.cc",
        "src/ingest/update_coordinator.cc",
    ],
    hdrs = [
        "src/ingest/kafka_update_consumer.h",
        "src/ingest/update_applier.h",
        "src/ingest/update_coordinator.h",
    ],
    copts = [
        "-Xclang",
        "-isystem",
        "-Xclang",
        "/opt/homebrew/opt/librdkafka/include",
    ],
    deps = [
        ":kv_index_base",
        ":kv_index_model",
        ":kv_index_public_headers",
        ":kv_index_store",
    ],
    linkopts = ["/opt/homebrew/opt/librdkafka/lib/librdkafka.dylib"],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_rebuild",
    srcs = [
        "src/rebuild/async_load.cc",
        "src/rebuild/compaction.cc",
        "src/rebuild/full_rebase.cc",
    ],
    hdrs = [
        "src/rebuild/async_load.h",
        "src/rebuild/compaction.h",
        "src/rebuild/full_rebase.h",
    ],
    deps = [
        ":kv_index_artifact",
        ":kv_index_base",
        ":kv_index_ingest",
        ":kv_index_model",
        ":kv_index_public_headers",
        ":kv_index_runtime",
        ":kv_index_store",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_api",
    srcs = [
        "src/api/forward_index.cc",
    ],
    deps = [
        ":kv_index_base",
        ":kv_index_public_headers",
        ":kv_index_rebuild",
        ":kv_index_runtime",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_testing_internal",
    hdrs = [
        "src/testing/test_peer.h",
    ],
    deps = [
        ":kv_index_public_headers",
        ":kv_index_runtime",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_internal",
    deps = [
        ":kv_index_api",
        ":kv_index_artifact",
        ":kv_index_base",
        ":kv_index_ingest",
        ":kv_index_model",
        ":kv_index_rebuild",
        ":kv_index_runtime",
        ":kv_index_store",
        ":kv_index_testing_internal",
    ],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index_version",
    srcs = ["src/version.cc"],
    deps = [":kv_index_public_headers"],
    visibility = INTERNAL_VISIBILITY,
)

cc_library(
    name = "kv_index",
    deps = [":kv_index_public_headers"],
    implementation_deps = [
        ":kv_index_internal",
        ":kv_index_version",
    ],
)
